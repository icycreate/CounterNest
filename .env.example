# Browser-safe values only. Never put service-role/secret keys in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_BROWSER_SAFE_PUBLISHABLE_KEY
# Legacy alternative: VITE_SUPABASE_ANON_KEY (publishable key takes precedence)
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
# Optional canonical production URL. Leave blank initially to use the current origin.
VITE_PUBLIC_APP_URL=
# Optional explicit local/demo preview. Never enable on a production POS.
VITE_ENABLE_DEMO=false
